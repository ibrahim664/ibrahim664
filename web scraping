import requests
from bs4 import BeautifulSoup

headers = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/71.0.3578.98 Safari/537.36'
}

url = 'https://www.jumia.com.eg/catalog/?q=Arctic+Hunter'
r = requests.get(url, headers=headers)
soup = BeautifulSoup(r.content, 'html.parser')

s = soup.find('div', class_='pg-w -ptm -pbxl')

x = s.find('a', attrs={"aria-label": "Next Page"})
next_page = "https://www.jumia.com.eg" + x.get('href')

x = s.find('a', attrs={"aria-label": "Last Page"})
last_page = "https://www.jumia.com.eg" + x.get('href')

ct = 0
flag = 0

while flag == 0:

    r = requests.get(url, headers=headers)
    soup = BeautifulSoup(r.content, 'html.parser')
    s = soup.find('div', class_='-paxs row _no-g _4cl-3cm-shs')
    for link in s.find_all('a'):

        url2 = "https://www.jumia.com.eg" + link.get('href')
        r = requests.get(url2, headers=headers)
        soup = BeautifulSoup(r.content, 'html.parser')

        products = soup.find_all('a', class_='core')
        for product in products:
            company_name = product.find('h3', class_='name')
            if company_name:
                company_text = company_name.text.strip()
                print(company_text)

        s1 = soup.find('h1', attrs={"class": "-fs20 -pts -pbxs"})
        s2 = soup.find('span', attrs={"class": "-b -ltr -tal -fs24"})
        rating = soup.find("div", {"class": "-df -i-ctr -pvxs"})

        ct += 1
        print(ct)
        print(url2)
        print(s1.get_text())
        print(s2.get_text())
        print(rating.get_text())
        s = soup.find('div', id='imgs')
        for link in s.find_all('a'):
            print(link.get('href'))

    if url == last_page:
        flag = 1

    url = next_page

    if url != last_page:
        r = requests.get(url, headers=headers)
        soup = BeautifulSoup(r.content, 'html.parser')
        s = soup.find('div', class_='pg-w -ptm -pbxl')
        x = s.find('a', attrs={"aria-label": "Next Page"})
        next_page = "https://www.jumia.com.eg" + x.get('href')
